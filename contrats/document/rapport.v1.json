{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forge://document/rapport@1",
  "title": "Rapport",
  "description": "Rapport daté : Markdown + HTML (mode sombre), images, alertes. Les chemins sont relatifs au dossier « rapports » de la brique.",
  "type": "object",
  "required": ["titre", "date", "markdown", "html"],
  "properties": {
    "titre": { "type": "string" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "markdown": { "type": "string", "description": "Chemin du fichier .md" },
    "html": { "type": "string", "description": "Chemin du fichier .html" },
    "images": { "type": "array", "items": { "type": "string" } },
    "resume": { "type": "string" },
    "alertes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["niveau", "message"],
        "properties": {
          "niveau": { "type": "string", "enum": ["info", "attention", "critique"] },
          "message": { "type": "string" }
        }
      }
    },
    "manques": { "type": "array", "items": { "type": "string" } }
  }
}
